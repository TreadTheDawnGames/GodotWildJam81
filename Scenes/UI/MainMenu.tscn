[node name="RichTextLabel" type="RichTextLabel" parent="PanelContainer/MarginContainer/VBoxContainer/HBoxContainer/BuildingShip"]
layout_mode = 2
text = "The road to Cordova was rocky and our ship is barely hanging on.
We will have the ability to build up our ship again at pit stops on the way home. However our resources are limited, we have to be mindful of the parts we decide to acquire!

We have gotten reports of pirates trying to get their filthy hands on our payload. Not only will we have to evade asteroids but we will also have to take down potential threats. Be careful, cadet!"
fit_content = true

